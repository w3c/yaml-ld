<https://rubygems.org/gems/yaml-ld> a doap:Project, earl:TestSubject, earl:Software ;
  doap:name "YAML_LD"^^xsd:string ;
  doap:shortdesc "YAML-LD support for Ruby."@en ;
  doap:description "YAML_LD parses and serializes YAML-LD by transforming to and from JSON-LD."@en ;
  doap:homepage <https://github.com/ruby-rdf/yaml-ld> ;
  doap:bug-database <https://github.com/ruby-rdf/yaml-ld/issues> ;
  doap:implements <https://www.w3.org/TR/yaml-ld/> ;
  doap:license <https://unlicense.org/1.0/> ;
  doap:programming-language "Ruby" ;
  doap:developer <https://greggkellogg.net/foaf#me> ;
  doap:release [
    doap:name "yaml-ld-0.0.3+55c8c6e" ;
    doap:revision "55c8c6ef2960a03ecca7ade5a5810e2f25699086" ;
    doap:created "2025-03-11"^^xsd:date
  ] .

<https://greggkellogg.net/foaf#me> a foaf:Person ;
